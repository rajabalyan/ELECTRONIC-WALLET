# Shared / service settings
ENVIRONMENT=development
JWT_SECRET=change-me-dev-secret
LOG_LEVEL=INFO

# Local development defaults: SQLite keeps the demo runnable without MySQL
# Change these to real MySQL URLs only when you are intentionally configuring a
# production-like environment outside the demo stack.

# OnboardingService
ONBOARDING_DB_URL=sqlite+aiosqlite:///./onboarding.db
ONBOARDING_REDIS_URL=sqlite+aiosqlite:///./cache.db
ONBOARDING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ONBOARDING_NOTIFICATION_SERVICE_URL=http://localhost:8004
ONBOARDING_JWT_SECRET=change-me-dev-secret
ONBOARDING_JWT_ALGORITHM=HS256
ONBOARDING_JWT_EXPIRE_MINUTES=60

# WalletService
WALLET_DB_URL=sqlite+aiosqlite:///./wallet.db
WALLET_REDIS_URL=sqlite+aiosqlite:///./cache.db
WALLET_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
WALLET_INITIAL_BALANCE=100.00
WALLET_JWT_SECRET=change-me-dev-secret
WALLET_JWT_ALGORITHM=HS256

# TransactionService
TRANSACTION_DB_URL=sqlite+aiosqlite:///./transaction.db
TRANSACTION_REDIS_URL=sqlite+aiosqlite:///./cache.db
TRANSACTION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTION_JWT_SECRET=change-me-dev-secret
TRANSACTION_JWT_ALGORITHM=HS256
TRANSACTION_SERVICE_URL=http://localhost:8003
TRANSACTION_WALLET_SERVICE_URL=http://localhost:8002

# NotificationService
NOTIFICATION_REDIS_URL=sqlite+aiosqlite:///./cache.db
NOTIFICATION_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_SMTP_HOST=localhost
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=no-reply@example.com
NOTIFICATION_SMTP_USE_TLS=false
NOTIFICATION_EMAIL_MODE=development
NOTIFICATION_JWT_SECRET=change-me-dev-secret

# Kafka topics
USER_CREATION_TOPIC=user-creation-topic
TXN_INITIATION_TOPIC=txn-initiation-topic
TXN_UPDATE_KAFKA_TOPIC=txn-update-topic

# OTP / security settings
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
